import /init.environ.rc
import /init.zx9.data.rc

on early-init
    start ueventd

on init
    # No media.metrics daemon in this image; avoid blocking every fresh app teardown.
    setprop media.metrics.enabled 0
    exec /sony/busybox sh /sony/power-access.sh
    mkdir /dev/socket 0755 root root
    mkdir /dev/pts 0755 root root
    mount devpts devpts /dev/pts mode=0620,ptmxmode=0666,gid=5
    mkdir /sys/kernel/debug 0755 root root
    mount debugfs debugfs /sys/kernel/debug
    symlink /sys/kernel/debug /d
    mkdir /acct 0755 root root
    mount cgroup none /acct cpuacct
    mkdir /dev/cpuctl 0755 system system
    mount cgroup none /dev/cpuctl cpu
    mkdir /dev/cpuctl/foreground 0755 system system
    mkdir /dev/cpuctl/background 0755 system system
    mkdir /dev/cpuctl/system-background 0755 system system
    mkdir /dev/cpuctl/top-app 0755 system system
    mkdir /dev/cpuctl/rt 0755 system system
    mkdir /mnt 0755 root root
    mount tmpfs tmpfs /mnt size=16m,mode=0755
    mkdir /mnt/user 0755 root root
    mkdir /mnt/user/0 0755 root root
    mkdir /mnt/runtime 0700 root root
    mkdir /mnt/runtime/default 0755 root root
    mkdir /mnt/runtime/default/self 0755 root root
    mkdir /mnt/runtime/read 0755 root root
    mkdir /mnt/runtime/read/self 0755 root root
    mkdir /mnt/runtime/write 0755 root root
    mkdir /mnt/runtime/write/self 0755 root root
    mkdir /mnt/secure 0700 root root
    mkdir /mnt/secure/asec 0700 root root
    mkdir /mnt/asec 0755 root system
    mkdir /mnt/obb 0755 root system
    mkdir /mnt/media_rw 0750 root media_rw
    mkdir /mnt/expand 0771 system system
    mkdir /mnt/appfuse 0711 root root
    mkdir /storage 0755 root root
    mount tmpfs tmpfs /storage size=16m,mode=0755
    symlink /storage/self/primary /sdcard
    symlink /storage/self/primary /mnt/sdcard
    symlink /mnt/user/0/primary /mnt/runtime/default/self/primary
    mount rootfs rootfs / shared rec
    mount none /mnt/runtime/default /storage bind rec
    mount none none /storage slave rec
    mkdir /cache 0770 system cache
    mount tmpfs tmpfs /cache size=16m,mode=0770,uid=1000,gid=2001
    write /sys/power/wake_lock zx9_suspend_bringup_guard
    write /sys/power/dpidle_state 0
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/setup_properties.sh
    load_system_props
    setrlimit nofile 32768 32768
    setrlimit nice 40 40
    setrlimit rtprio 10 10
    write /proc/sys/vm/overcommit_memory 1
    write /proc/sys/vm/mmap_min_addr 32768
    setprop service.adb.root 1
    # This kernel exposes FunctionFS without asynchronous I/O support.
    setprop sys.usb.ffs.aio_compat 1
    setprop log.tag.HWC2OnFbAdapter W
    start logd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/SelfPowered 0
    write /sys/class/android_usb/android0/MaxPower 500
    write /sys/class/android_usb/android0/idVendor 054C
    write /sys/class/android_usb/android0/idProduct 0CA1
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    write /sys/class/android_usb/android0/f_mass_storage/nluns 2
    write /sys/class/android_usb/android0/f_mass_storage/lun/file ""
    write /sys/class/android_usb/android0/f_mass_storage/lun1/file ""
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/functions mass_storage,ffs
    start adbd
    write /sys/class/android_usb/android0/enable 1

on late-init
    trigger zx9-data
    trigger boot

on boot
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/radio/local-config.sh
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/audio-dac/init.sh
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/sony-audio-runtime/setup.sh
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/bt-output/setup.sh
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/jack-framework/setup.sh
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/app-policy/setup.sh
    setprop sys.zx300a.android_lab walkdroid-b115
    setprop sys.zx300a.core_ready 1
    setprop sys.zx300a.start_graphics 1
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/setup_graphics.sh
    start servicemanager
    start hwservicemanager
    start zx9_configstore
    start zx9_allocator
    start zx9_composer
    start surfaceflinger
    setprop sys.zx300a.start_framework 1

on property:sys.zx300a.start_framework=1
    start hidl_memory
    start zx9_codec
    restorecon_recursive /system/app/Bluetooth
    restorecon_recursive /system/app/NfcNci
    mkdir /data/misc/bluedroid 0770 bluetooth bluetooth
    mkdir /data/nfc 0770 nfc nfc
    start zx9_wmt_launcher
    start zx9_radio
    start zx9_camera
    start lmkd
    start tombstoned
    start installd
    start vold
    start storaged
    start netd
    start keystore
    start gatekeeperd
    start healthd
    exec u:r:su:s0 root root -- /vendor/bin/sony-cpu-init
    start zx9_light
    start zx9_keymaster
    start media
    start mediaextractor
    start statsd
    start zygote

service ueventd /sbin/ueventd
    class core
    user root
    seclabel u:r:ueventd:s0

service adbd /sony/busybox sh /sony/adbd-launch.sh
    class core
    user root
    socket adbd stream 660 system system
    disabled
    seclabel u:r:su:s0

service servicemanager /system/bin/servicemanager
    shutdown critical
    user root
    disabled
    seclabel u:r:servicemanager:s0

service hwservicemanager /system/bin/hwservicemanager
    shutdown critical
    user root
    disabled
    seclabel u:r:hwservicemanager:s0

service zx9_configstore /sony/zx9-configstore-service
    user root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

service zx9_allocator /vendor/bin/hw/android.hardware.graphics.allocator@2.0-service
    user root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

service zx9_composer /vendor/bin/hw/android.hardware.graphics.composer@2.1-service
    user root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

service surfaceflinger /system/bin/surfaceflinger
    user root
    disabled
    seclabel u:r:surfaceflinger:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

service zygote /system/bin/app_process32 -Xzygote /system/bin --zygote --start-system-server
    user root
    group root readproc reserved_disk
    socket zygote stream 660 root system
    priority -20
    disabled
    oneshot
    seclabel u:r:zygote:s0

service healthd /system/bin/healthd
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib
    setenv LD_PRELOAD /vendor/lib/libzx9_healthd_uevent_filter.so
    user root
    disabled
    seclabel u:r:healthd:s0

service zx9_audio /sony/sony-audio-runtime/audio-service.sh
    user root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

service zx9_keymaster /vendor/bin/hw/zx9-keymaster-service
    user root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

service zx9_light /vendor/bin/hw/zx9-light-service
    user root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

service zx9_camera /system/bin/cameraserver
    user root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /vendor/lib:/system/lib:/system/lib/vndk-28:/system/lib/vndk-sp-28

on property:sys.boot_completed=1
    exec u:r:su:s0 root root -- /sony/busybox sh /sony/lineage_provision.sh

service zx9_codec /sony/zx9-codec-launch.sh
    user mediacodec
    group audio media drmrpc readproc
    disabled
    seclabel u:r:mediacodec:s0

on post-fs-data
    mkdir /data/misc/bluedroid 0770 bluetooth bluetooth
    mkdir /data/nfc 0770 nfc nfc
    start zx9_wmt_launcher
    start zx9_radio

service zx9_wmt_launcher /sony/radio/native/lib/ld-linux-armhf.so.3 --library-path /sony/radio/native/lib /sony/radio/native/6620_launcherA -p /sony/radio/firmware/
    class hal
    user root
    group root system
    seclabel u:r:su:s0
    disabled

service zx9_radio /sony/radio/hal-launch.sh
    class hal
    user root
    group root system bluetooth nfc
    seclabel u:r:su:s0
    disabled

on property:sys.zx300a.start_framework=1
    start zx9_audio
    start audioserver

service zx9_dsf_player /sony/busybox sh /sony/player/run.sh
    user root
    group root
    disabled
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /data/walkdroid/player/lib:/vendor/lib:/system/lib

on property:sys.boot_completed=1
    start zx9_dsf_player

service zx9_receiver /sony/busybox sh /sony/usb-settings/receiver-log.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:su:s0
    setenv LD_LIBRARY_PATH /sony/usb-source/lib:/sony/usb-startup-trace/lib:/data/walkdroid/receiver/lib:/vendor/lib:/system/lib

on property:sys.boot_completed=1
    start zx9_receiver

# Passive private BT listener. Audio, RF and CPU ownership are acquired only ON.
service zx9_bt_receiver /sony/busybox sh /sony/bt-settings/receiver-log.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start zx9_bt_receiver

service zx9_bt_link /sony/busybox sh /sony/bt-link/run.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start zx9_bt_link


# WalkDroid release: stop the boot animation when Android reports boot complete.
on property:sys.boot_completed=1
    setprop service.bootanim.exit 1
